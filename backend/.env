# Anthropic Claude API (for GEO audit and AI response drafting)
ANTHROPIC_API_KEY=sk-ant-...

# Note: Reddit API uses public JSON endpoint - NO CREDENTIALS NEEDED!
# Automatically fetches from: https://www.reddit.com/r/{subreddit}/search.json

# Optional: Twitter/X API (for real X/Twitter mentions)
# TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Optional: HuggingFace API Key (for private/fine-tuned models)
# HUGGINGFACE_API_KEY=hf_...

# Optional: OpenAI API Key (alternative to Claude for GEO audit)
# OPENAI_API_KEY=sk_...
